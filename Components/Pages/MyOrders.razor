@page "/myorders"
@using BlazingPizza
@inject HttpClient HttpClient

<h3>My Orders</h3>

@if (orders == null)
{
    <p><em>Loading...</em></p>
}
else if (!orders.Any())
{
    <p>You have no orders yet.</p>
}
else
{
    <ul>
        @foreach (var orderWithStatus in orders)
        {
            <li>
                <a href="orderdetails/@orderWithStatus.Order.OrderId">
                    Order #@orderWithStatus.Order.OrderId -
                    @orderWithStatus.StatusText -
                    ₵@orderWithStatus.Order.GetTotalPrice()
                </a>
            </li>
        }
    </ul>
}

@code {
    List<OrderWithStatus> orders;

    protected override async Task OnInitializedAsync()
    {
        orders = await HttpClient.GetFromJsonAsync<List<OrderWithStatus>>("orders");
    }
}
