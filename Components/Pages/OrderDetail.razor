@page "/orderdetails/{orderId:int}"
@using BlazingPizza
@inject HttpClient HttpClient

<h3>Order Details</h3>

@if (orderWithStatus == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="order-details">
        <h4>Order #@orderWithStatus.Order.OrderId</h4>
        <p>Status: <strong>@orderWithStatus.StatusText</strong></p>
        <p>Placed: @orderWithStatus.Order.CreatedTime.ToLocalTime()</p>

        <h5>Pizzas</h5>
        <ul>
            @foreach (var pizza in orderWithStatus.Order.Pizzas)
            {
                <li>
                    @pizza.Size Pizza - ₵@pizza.GetTotalPrice()
                    <ul>
                        @foreach (var topping in pizza.Toppings)
                        {
                            <li>@topping.Name (₵@topping.Price)</li>
                        }
                    </ul>
                </li>
            }
        </ul>

        <p><strong>Total: ₵@orderWithStatus.Order.GetTotalPrice()</strong></p>
    </div>
}

@code {
    [Parameter]
    public int orderId { get; set; }

    private OrderWithStatus orderWithStatus;

    protected override async Task OnInitializedAsync()
    {
        // Fetch order from server API
        orderWithStatus = await HttpClient.GetFromJsonAsync<OrderWithStatus>($"orders/{orderId}");
    }
}
