@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/blazor" target="_blank">About Blazor</a>
        </div>

        <div class="content px-4">
            @Body
        </div>
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            © 2026 - Charles Kingsley Ajeigbe | Ghana
        </div>
    </footer>

</div>

@code {
    // Utility method for formatting amounts in Ghanaian Cedis
    public static string FormatCedis(decimal amount)
    {
        return string.Format("₵{0:N2}", amount);
    }
}
